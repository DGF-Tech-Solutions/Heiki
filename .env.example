# Database - `docker compose up -d` avvia un Postgres con queste credenziali
DATABASE_URL="postgresql://gachazone:gachazone@localhost:5432/gachazone"

# Auth.js - genera un segreto con: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Indirizzo pubblico, usato da sitemap, robots e metadati di condivisione
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# OAuth opzionale: i pulsanti compaiono solo se queste variabili sono valorizzate
AUTH_DISCORD_ID=""
AUTH_DISCORD_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Avviso ai moderatori quando arriva una schermata da verificare (facoltativo):
# Discord > Impostazioni del canale > Integrazioni > Webhook > Copia URL
DISCORD_WEBHOOK_MODERAZIONE=""

# Enka.Network - profili pubblici via UID, nessuna credenziale utente
ENKA_API_BASE="https://enka.network/api"
ENKA_USER_AGENT="Heiki/0.1 (contact@example.com)"

# Stripe (cosmetici + abbonamento premium)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
