{
  "name": "gachazone",
  "version": "0.1.0",
  "private": true,
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 111",
    "safari >= 16.4",
    "ios_saf >= 16.4",
    "not dead"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.mts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx scripts/seed.mts",
    "db:reset": "docker compose down -v && node scripts/setup.mjs",
    "db:smoke": "tsx scripts/smoke-db.mts",
    "promote": "tsx scripts/promote.mts",
    "eroi:import": "tsx scripts/import-heroes.mts && tsx scripts/import-endgame.mts && tsx scripts/import-artifacts.mts",
    "endgame:import": "tsx scripts/import-endgame.mts",
    "artefatti:import": "tsx scripts/import-artifacts.mts",
    "docker:app": "docker compose --profile app up --build"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.44.7",
    "next": "^15.3.1",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^3.4.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=20"
  }
}
